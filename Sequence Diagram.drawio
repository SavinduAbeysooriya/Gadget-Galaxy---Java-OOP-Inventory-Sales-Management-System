<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="oXc2GS9jxEuKcEuCiHk5">
    <mxGraphModel dx="1585" dy="811" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml SequenceDiagram_Simple\nskinparam backgroundColor #0C0E14\nskinparam sequence {\n  ArrowColor #409CFF\n  ArrowFontColor #8090B0\n  ActorBorderColor #409CFF\n  ActorBackgroundColor #1A2035\n  ActorFontColor #FFFFFF\n  ParticipantBorderColor #409CFF\n  ParticipantBackgroundColor #16181A\n  ParticipantFontColor #DCE1F0\n  LifeLineBorderColor #2830A0\n  DividerBackgroundColor #1A2035\n  DividerBorderColor #409CFF\n  DividerFontColor #409CFF\n  GroupBorderColor #409CFF\n  GroupFontColor #409CFF\n  NoteBackgroundColor #1A2035\n  NoteBorderColor #409CFF\n  NoteFontColor #DCE1F0\n}\n\nactor \&quot;User\&quot; as U\nparticipant \&quot;UI (View)\&quot; as UI\nparticipant \&quot;AppController\&quot; as AC\nparticipant \&quot;Service Layer\&quot; as SV\nparticipant \&quot;DAO Layer\&quot; as DAO\ndatabase \&quot;MySQL DB\&quot; as DB\nparticipant \&quot;File System\&quot; as FS\n\n== 1. Login ==\nU -&gt; UI : Enter username &amp; password\nUI -&gt; AC : login(username, password)\nAC -&gt; SV : authenticate &amp; hash password\nSV -&gt; DAO : findByUsername()\nDAO -&gt; DB : SELECT users\nDB --&gt; DAO : User record\nDAO --&gt; SV : User object\nSV --&gt; AC : session started\nAC --&gt; UI : open Dashboard\nUI --&gt; U : Dashboard displayed\n\n== 2. Background Threads ==\nnote over AC : 3 daemon threads start automatically\nAC -&gt; SV : [every 30s] check low stock\nSV -&gt; DB : SELECT low stock items\nDB --&gt; SV : results\nSV --&gt; U : show alert if low stock\nAC -&gt; FS : [every 60s] backup inventory CSV\n\n== 3. Manage Products / Inventory ==\nU -&gt; UI : Add / Edit / View product or stock\nUI -&gt; AC : call product / inventory action\nAC -&gt; SV : business logic &amp; validation\nSV -&gt; DAO : INSERT / UPDATE / SELECT\nDAO -&gt; DB : execute query\nDB --&gt; DAO : result\nDAO --&gt; SV : data\nSV --&gt; UI : updated data\nUI --&gt; U : show result\n\n== 4. Process Sale (POS) ==\nU -&gt; UI : Add items to cart &amp; checkout\nUI -&gt; AC : processCheckout(items, customer, payment)\nAC -&gt; SV : validate &amp; calculate total\nSV -&gt; DAO : save sale + sale_items\\ndeduct inventory stock\nDAO -&gt; DB : INSERT sales, sale_items\\nUPDATE inventory\nDB --&gt; DAO : success\nSV -&gt; FS : write invoice .txt file\nSV --&gt; UI : return invoice text\nUI --&gt; U : show invoice dialog\n\n== 5. Logout ==\nU -&gt; UI : click Logout\nUI -&gt; AC : logout()\nAC -&gt; SV : clear session\nSV -&gt; FS : write logout to audit log\nAC --&gt; UI : open Login screen\nUI --&gt; U : Login form displayed\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="odz60mln41zQAW0rqa3e-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1539" width="1267" x="30" y="10" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
