<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="-Ex3VMK0mqeS3TTdRSaH">
    <mxGraphModel dx="1212" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml ClassDiagram_DB\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam backgroundColor #0C0E14\nskinparam class {\n  BackgroundColor #16181A\n  BorderColor #409CFF\n  FontColor #DCE1F0\n  HeaderBackgroundColor #1A2035\n  HeaderFontColor #FFFFFF\n  AttributeFontColor #B0B8D0\n  StereotypeFontColor #409CFF\n}\nskinparam arrow {\n  Color #409CFF\n  FontColor #8090B0\n  FontSize 10\n}\nskinparam note {\n  BackgroundColor #1A2035\n  BorderColor #409CFF\n  FontColor #DCE1F0\n}\n\n&#39; ==================== TABLES ====================\n\nclass roles &lt;&lt;Table&gt;&gt; {\n  PK  role_id : INT AI\n  --\n      role_name : VARCHAR(50) UNIQUE NOT NULL\n}\n\nclass users &lt;&lt;Table&gt;&gt; {\n  PK  user_id : INT AI\n  --\n      full_name : VARCHAR(100) NOT NULL\n      username : VARCHAR(50) UNIQUE NOT NULL\n      password_hash : VARCHAR(255) NOT NULL\n      email : VARCHAR(100) NOT NULL\n      phone : VARCHAR(20)\n  FK  role_id : INT NOT NULL\n      created_at : TIMESTAMP DEFAULT NOW\n      status : ENUM(ACTIVE, INACTIVE)\n}\n\nclass categories &lt;&lt;Table&gt;&gt; {\n  PK  category_id : INT AI\n  --\n      category_name : VARCHAR(50) UNIQUE NOT NULL\n      description : TEXT\n}\n\nclass brands &lt;&lt;Table&gt;&gt; {\n  PK  brand_id : INT AI\n  --\n      brand_name : VARCHAR(50) UNIQUE NOT NULL\n      country : VARCHAR(50)\n}\n\nclass products &lt;&lt;Table&gt;&gt; {\n  PK  product_id : INT AI\n  --\n      product_code : VARCHAR(50) UNIQUE NOT NULL\n      product_name : VARCHAR(100) NOT NULL\n      model : VARCHAR(50) NOT NULL\n  FK  category_id : INT NOT NULL\n  FK  brand_id : INT NOT NULL\n      specifications : TEXT\n      unit_price : DECIMAL(10,2) &gt;= 0\n      warranty_months : INT DEFAULT 0\n      image_path : VARCHAR(255)\n  FK  created_by : INT\n      created_at : TIMESTAMP DEFAULT NOW\n}\n\nclass inventory &lt;&lt;Table&gt;&gt; {\n  PK  inventory_id : INT AI\n  --\n  FK  product_id : INT UNIQUE NOT NULL\n      quantity_in_stock : INT DEFAULT 0 &gt;= 0\n      reorder_level : INT DEFAULT 5 &gt;= 0\n      last_stock_update : TIMESTAMP ON UPDATE NOW\n}\n\nclass customers &lt;&lt;Table&gt;&gt; {\n  PK  customer_id : INT AI\n  --\n      customer_name : VARCHAR(100) NOT NULL\n      phone : VARCHAR(20) NOT NULL\n      email : VARCHAR(100)\n      address : TEXT\n}\n\nclass sales &lt;&lt;Table&gt;&gt; {\n  PK  sale_id : INT AI\n  --\n      invoice_no : VARCHAR(50) UNIQUE NOT NULL\n  FK  customer_id : INT (nullable)\n  FK  sold_by : INT NOT NULL\n      sale_date : TIMESTAMP DEFAULT NOW\n      total_amount : DECIMAL(10,2) &gt;= 0\n      payment_method : ENUM(CASH, CARD, MOBILE)\n      sale_status : ENUM(COMPLETED, CANCELLED)\n}\n\nclass sale_items &lt;&lt;Table&gt;&gt; {\n  PK  sale_item_id : INT AI\n  --\n  FK  sale_id : INT NOT NULL\n  FK  product_id : INT NOT NULL\n      quantity : INT &gt; 0\n      unit_price : DECIMAL(10,2) &gt;= 0\n      subtotal : DECIMAL(10,2) &gt;= 0\n}\n\nclass suppliers &lt;&lt;Table&gt;&gt; {\n  PK  supplier_id : INT AI\n  --\n      supplier_name : VARCHAR(100) NOT NULL\n      contact_person : VARCHAR(100)\n      phone : VARCHAR(20) NOT NULL\n      email : VARCHAR(100)\n      address : TEXT\n}\n\nclass product_suppliers &lt;&lt;Table&gt;&gt; {\n  PK  product_supplier_id : INT AI\n  --\n  FK  product_id : INT NOT NULL\n  FK  supplier_id : INT NOT NULL\n      UNIQUE(product_id, supplier_id)\n}\n\nclass audit_logs &lt;&lt;Table&gt;&gt; {\n  PK  log_id : INT AI\n  --\n  FK  user_id : INT (nullable)\n      action : VARCHAR(255) NOT NULL\n      log_time : TIMESTAMP DEFAULT NOW\n}\n\n&#39; ==================== RELATIONSHIPS ====================\n\nroles \&quot;1\&quot; --o{ \&quot;0..*\&quot; users : \&quot;role_id\\nON UPDATE CASCADE\&quot;\n\ncategories \&quot;1\&quot; --o{ \&quot;0..*\&quot; products : \&quot;category_id\\nON UPDATE CASCADE\&quot;\n\nbrands \&quot;1\&quot; --o{ \&quot;0..*\&quot; products : \&quot;brand_id\\nON UPDATE CASCADE\&quot;\n\nusers \&quot;1\&quot; --o{ \&quot;0..*\&quot; products : \&quot;created_by\\nON DELETE SET NULL\&quot;\n\nproducts \&quot;1\&quot; ||--|| \&quot;1\&quot; inventory : \&quot;product_id\\nON DELETE CASCADE\&quot;\n\ncustomers \&quot;1\&quot; --o{ \&quot;0..*\&quot; sales : \&quot;customer_id\\nON DELETE SET NULL\&quot;\n\nusers \&quot;1\&quot; --o{ \&quot;0..*\&quot; sales : \&quot;sold_by\\nON UPDATE CASCADE\&quot;\n\nsales \&quot;1\&quot; ||--o{ \&quot;1..*\&quot; sale_items : \&quot;sale_id\\nON DELETE CASCADE\&quot;\n\nproducts \&quot;1\&quot; --o{ \&quot;0..*\&quot; sale_items : \&quot;product_id\\nON UPDATE CASCADE\&quot;\n\nproducts \&quot;1\&quot; --o{ \&quot;0..*\&quot; product_suppliers : \&quot;product_id\\nON DELETE CASCADE\&quot;\n\nsuppliers \&quot;1\&quot; --o{ \&quot;0..*\&quot; product_suppliers : \&quot;supplier_id\\nON DELETE CASCADE\&quot;\n\nusers \&quot;1\&quot; --o{ \&quot;0..*\&quot; audit_logs : \&quot;user_id\\nON DELETE SET NULL\&quot;\n\n&#39; ==================== NOTES ====================\n\nnote bottom of inventory\n  LOW STOCK condition:\n  quantity_in_stock &lt;= reorder_level\nend note\n\nnote bottom of sales\n  Walk-in sale: customer_id = NULL\n  Invoice format: INV_YYYY_NNNN\nend note\n\nnote right of product_suppliers\n  Junction table for\n  Many-to-Many between\n  products &amp; suppliers\nend note\n\nnote right of users\n  password_hash = SHA-256\n  role_id 1 = Store Manager\n  role_id 2 = Sales Representative\nend note\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="7d2YUpp0pNRDEbNAjzIi-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="942" width="1660" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
